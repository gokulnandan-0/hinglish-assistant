{
  "name": "nova-tutor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "smoke": "tsx --env-file-if-exists=.env eval/run.ts smoke",
    "db:up": "docker compose up -d"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@azure/storage-blob": "^12.34.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@opentelemetry/api": "^1.9.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "openai": "^7.25.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
