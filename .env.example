# ---------------------------------------------------------------------------
# Nova tutor backend. See docs/AZURE_REQUIREMENTS.md for how to obtain each value.
# Keys are optional in deployed environments: leave *_KEY empty to use Entra ID
# (managed identity) through DefaultAzureCredential.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Auth (Entra External ID). Dev-only HS256 secret for local testing:
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_DEV_SECRET=change-me-dev-secret-at-least-16

# ---- Azure AI Speech (Central India) - STT, Pronunciation Assessment, TTS
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_CUSTOM_ENDPOINT_ID=
PRON_DETAIL_MODE=dual
PRON_DETAIL_GRACE_MS=350
STT_PHRASE_LIST_EXTRA=

TTS_VOICE_CONVERSATION=en-IN-NeerjaNeural
TTS_VOICE_CLEAR=en-IN-PrabhatNeural
TTS_VOICE_L1_HINT=hi-IN-SwaraNeural
TTS_CLEAR_RATE=0.85
TTS_OUTPUT_FORMAT=ogg-opus
TTS_LEXICON_URL=

# ---- Azure OpenAI (South India), v1 API
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TUTOR_DEPLOYMENT=tutor-fast
AZURE_OPENAI_KIDS_DEPLOYMENT=tutor-kids
AZURE_OPENAI_SUMMARY_DEPLOYMENT=tutor-summary
# gpt-5.x reasoning models: none|minimal|low. Empty for gpt-4o / gpt-4.1-mini.
AZURE_OPENAI_REASONING_EFFORT=none
AZURE_OPENAI_RESPONSE_FORMAT=json_schema
LLM_MAX_OUTPUT_TOKENS=300

# ---- Azure AI Content Safety (South India)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ---- Data (local: docker compose up -d)
DATABASE_URL=postgres://nova:nova@localhost:5433/nova
DATABASE_SSL=false
REDIS_URL=redis://localhost:6380
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AUDIO_RETENTION_DAYS=30

# ---- Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=

RATE_LIMIT_TURNS_PER_MIN=20
MAX_UTTERANCE_SECONDS=30
